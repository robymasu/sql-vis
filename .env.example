# Copy this file to ".env" (same folder) and fill in your own key(s).
# See the ".env" file's own header comment for why this only works when
# SQL-Vis is served over http(s) — not when index.html is opened directly.
#
# Both providers' key/model are always read, regardless of AI_PROVIDER —
# that setting only picks which one the Provider dropdown starts on.

AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=

CLAUDE_API_KEY=
CLAUDE_MODEL=

# Server-only — used by api/rewrite.js (the Vercel Serverless Function for
# shared-team access), NEVER read by the browser's fetch('.env') above.
# Listed here anyway so Vercel's project-import screen auto-suggests it
# alongside the others — set a real value only in Vercel's own
# Environment Variables settings (or a local ".env" if using `vercel dev`),
# never commit a real password here.
SQLVIS_ACCESS_PASSWORD=
