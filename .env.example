# Copy this file to ".env" (same folder) and fill in your own key(s).
# See the ".env" file's own header comment for why this only works when
# SQL-Vis is served over http(s) — not when index.html is opened directly.
#
# Both providers' key/model are always read, regardless of AI_PROVIDER —
# that setting only picks which one the Provider dropdown starts on.

AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=

CLAUDE_API_KEY=
CLAUDE_MODEL=
